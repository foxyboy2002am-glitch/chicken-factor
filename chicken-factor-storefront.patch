@@ -0,0 +1,235 @@
+/*
+ * Storefront – final consolidated styles for the menu browser.
+ * Loaded LAST (see layout.tsx) so it is the single source of truth for the
+ * toolbar, category tabs and product cards. Older layers in globals.css and
+ * storefront-polish.css are intentionally overridden here.
+ */
+
+:root {
+  --cf-red: #b71922;
+  --cf-red-dark: #8f1219;
+  --cf-ink: #251e1c;
+  --cf-muted: #7d716c;
+  --cf-line: #eee3dd;
+  --cf-surface: #ffffff;
+  --cf-tint: #fbf3ee;
+  --cf-radius: 18px;
+}
+
+/* ---------- Accessibility ---------- */
+.store-page a:focus-visible,
+.store-page button:focus-visible,
+.store-page input:focus-visible,
+.cf-floating-cart button:focus-visible {
+  outline: 3px solid #ffb703;
+  outline-offset: 2px;
+}
+
+/* ---------- Toolbar + search ---------- */
+.cf-menu-toolbar {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 20px;
+  margin: 8px 0 18px;
+}
+.cf-menu-toolbar h2 { margin: 4px 0; font-size: 26px; color: var(--cf-ink); }
+.cf-menu-toolbar p { margin: 0; font-size: 13px; color: var(--cf-muted); }
+.cf-menu-kicker { font-size: 10px; letter-spacing: 2px; font-weight: 800; color: var(--cf-red); }
+
+.cf-menu-search {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  width: min(100%, 340px);
+  height: 46px;
+  padding: 0 14px;
+  border: 1px solid #e8dbd4;
+  border-radius: 14px;
+  background: var(--cf-surface);
+  box-shadow: 0 4px 14px #32100a08;
+  transition: border-color .2s, box-shadow .2s;
+}
+.cf-menu-search:focus-within { border-color: var(--cf-red); box-shadow: 0 0 0 3px #b7192214; }
+.cf-menu-search svg { flex: none; width: 18px; height: 18px; fill: none; stroke: #a08f88; stroke-width: 2; stroke-linecap: round; }
+.cf-menu-search input { width: 100%; border: 0; outline: 0; background: transparent; font-size: 14px; color: var(--cf-ink); }
+.cf-menu-search input::placeholder { color: #a99c96; }
+
+/* ---------- Category tabs ---------- */
+.cf-category-tabs {
+  display: flex;
+  gap: 8px;
+  overflow-x: auto;
+  padding: 10px 0 12px;
+  scroll-snap-type: x proximity;
+  scrollbar-width: none;
+  -webkit-overflow-scrolling: touch;
+}
+.cf-category-tabs::-webkit-scrollbar { display: none; }
+.cf-category-tabs button {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  flex: none;
+  min-height: 42px;
+  padding: 0 15px;
+  scroll-snap-align: start;
+  border: 1px solid #e9ded8;
+  border-radius: 999px;
+  background: var(--cf-surface);
+  color: #5d514d;
+  font-size: 13px;
+  font-weight: 700;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: background .2s, color .2s, border-color .2s;
+}
+.cf-category-tabs button:hover { border-color: var(--cf-red); color: var(--cf-red); }
+.cf-category-tabs button.is-active { border-color: var(--cf-red); background: var(--cf-red); color: #fff; box-shadow: 0 6px 16px #b7192230; }
+.cf-category-tabs button small {
+  display: grid; place-items: center; min-width: 20px; height: 20px; padding: 0 6px;
+  border-radius: 999px; background: #f6ebe6; color: #9e2825; font-size: 11px; font-weight: 700;
+}
+.cf-category-tabs button.is-active small { background: #ffffff30; color: #fff; }
+
+/* ---------- Active category heading ---------- */
+.cf-active-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; margin: 8px 0 18px; }
+.cf-active-heading > div > span { font-size: 10px; letter-spacing: 2px; font-weight: 800; color: var(--cf-red); }
+.cf-active-heading h3 { margin: 3px 0 0; font-size: 26px; color: var(--cf-ink); }
+.cf-active-heading > b { padding: 6px 12px; border-radius: 999px; background: #f8eae4; color: #a51a21; font-size: 12px; white-space: nowrap; }
+
+/* ---------- Product grid + card ---------- */
+.cf-product-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(236px, 1fr));
+  gap: 18px;
+}
+.cf-product-card {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  overflow: hidden;
+  border: 1px solid var(--cf-line);
+  border-radius: var(--cf-radius);
+  background: var(--cf-surface);
+  box-shadow: 0 6px 20px #32100a08;
+  transition: transform .22s, box-shadow .22s;
+}
+.cf-product-card:hover { transform: translateY(-3px); box-shadow: 0 16px 32px #32100a14; }
+
+.cf-product-visual {
+  position: relative;
+  height: auto;
+  min-height: 0;
+  aspect-ratio: 4 / 3;
+  overflow: hidden;
+  background: linear-gradient(135deg, #f7e9e1, #fbf5f0);
+}
+.cf-product-visual > img { display: block; width: 100%; height: 100%; object-fit: cover; }
+.cf-product-fresh { display: none; }
+
+.cf-product-art {
+  position: absolute; inset: 0;
+  display: flex; flex-direction: column; align-items: center; justify-content: center;
+  gap: 6px; padding: 14px; text-align: center;
+}
+.cf-product-art-brand { font-size: 9px; letter-spacing: 2px; font-weight: 800; color: #c9858a; }
+.cf-product-art strong { font-size: clamp(15px, 1.6vw, 20px); line-height: 1.35; color: #3a1c1a; overflow-wrap: anywhere; }
+.cf-product-art-icon { font-size: 26px; line-height: 1; }
+.cf-product-spark { display: none; }
+
+.cf-product-content { display: flex; flex: 1; flex-direction: column; padding: 14px 15px 15px; }
+.cf-product-meta { display: none; }
+.cf-product-content h4 { margin: 0; font-size: 17px; line-height: 1.4; color: var(--cf-ink); overflow-wrap: anywhere; }
+.cf-product-en { margin: 2px 0 0; font-size: 12px; color: #a47b75; direction: ltr; text-align: start; }
+.cf-product-description { display: block; margin: 8px 0 0; font-size: 12px; line-height: 1.7; color: var(--cf-muted); }
+
+.cf-variant-list { margin-top: auto; padding-top: 10px; border-top: 0; }
+.cf-variant-row {
+  display: flex; align-items: center; justify-content: space-between; gap: 10px;
+  padding: 10px 0; border-top: 1px solid #f3eae5; border-bottom: 0;
+}
+.cf-variant-row > div { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; min-width: 0; }
+.cf-variant-row > div > span { font-size: 12px; color: #6b5f5a; }
+.cf-variant-row > div > strong { font-size: 18px; line-height: 1.2; color: var(--cf-red); white-space: nowrap; font-weight: 800; }
+.cf-variant-row > div > strong small { font-size: 11px; font-weight: 600; color: #9c8d87; }
+.cf-unavailable { margin: 0; padding: 10px 0; font-size: 12px; color: var(--cf-muted); }
+
+.cf-add-cart {
+  flex: none;
+  min-height: 40px;
+  padding: 0 16px;
+  border: 0;
+  border-radius: 12px;
+  background: var(--cf-red);
+  color: #fff;
+  font-size: 13px;
+  font-weight: 700;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: background .2s, transform .1s;
+}
+.cf-add-cart:hover { background: var(--cf-red-dark); }
+.cf-add-cart:active { transform: scale(.97); }
+.cf-add-cart.is-added { background: #18834c; }
+
+.cf-no-products { padding: 40px 20px; border: 1px dashed #e7d5cd; border-radius: var(--cf-radius); background: #fff; text-align: center; color: var(--cf-muted); }
+
+/* ---------- Tablet ---------- */
+@media (max-width: 900px) {
+  .cf-product-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
+}
+
+/* ---------- Mobile: two vertical cards per row ---------- */
+@media (max-width: 650px) {
+  .cf-menu-toolbar { flex-direction: column; align-items: stretch; gap: 12px; }
+  .cf-menu-toolbar h2 { font-size: 22px; }
+  .cf-menu-search { width: 100%; }
+  .cf-category-tabs button { min-height: 40px; padding: 0 13px; font-size: 12px; }
+  .cf-active-heading h3 { font-size: 21px; }
+
+  .cf-product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
+  .cf-product-card { display: flex; flex-direction: column; border-radius: 15px; }
+  .cf-product-visual { height: auto; min-height: 0; aspect-ratio: 1 / 1; }
+  .cf-product-art { gap: 4px; padding: 10px; }
+  .cf-product-art strong { font-size: 14px; }
+  .cf-product-art-icon { font-size: 22px; }
+  .cf-product-content { padding: 11px 11px 12px; }
+  .cf-product-content h4 { font-size: 14px; }
+  .cf-product-en { font-size: 11px; }
+  .cf-product-description { display: none; }
+
+  .cf-variant-row { flex-direction: column; align-items: stretch; gap: 8px; padding: 9px 0; }
+  .cf-variant-row > div { flex-direction: row; align-items: baseline; justify-content: space-between; gap: 6px; }
+  .cf-variant-row > div > span { font-size: 11px; }
+  .cf-variant-row > div > strong { font-size: 16px; }
+  .cf-add-cart { width: 100%; min-height: 40px; padding: 0 8px; font-size: 12px; }
+}
+
+/* Very narrow phones: one card per row */
+@media (max-width: 340px) {
+  .cf-product-grid { grid-template-columns: 1fr; }
+}
+
+/* Arabic script must never be letter-spaced (it breaks the joined letters) */
+html[lang="ar"] .cf-menu-kicker,
+html[lang="ar"] .cf-active-heading > div > span { letter-spacing: 0; }
+
+/* English (LTR) alignment */
+html[lang="en"] .cf-product-content { text-align: left; }
+html[lang="en"] .cf-variant-row > div { text-align: left; }
+
+@media (prefers-reduced-motion: reduce) {
+  .cf-product-card, .cf-add-cart, .cf-category-tabs button { transition: none !important; }
+}
+
+/* ---------- Floating cart: follow the active language direction ----------
+ * globals.css hard-codes `direction: rtl` on .cf-floating-cart, which beat the
+ * dir attribute and left the English cart mirrored (punctuation at the wrong
+ * end, close button on the wrong side). */
+.cf-floating-cart[dir="ltr"] { direction: ltr; }
+.cf-floating-cart[dir="rtl"] { direction: rtl; }
+.cf-floating-cart[dir="ltr"] .cf-cart-panel-head,
+.cf-floating-cart[dir="ltr"] .cf-cart-line-info,
+.cf-floating-cart[dir="ltr"] .cf-cart-panel-foot { text-align: left; }
+.cf-floating-cart[dir="ltr"] .cf-cart-line > .cf-cart-line-total { text-align: right; }
