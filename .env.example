# Public Supabase settings (safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only Supabase key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_ON_SERVER

# Paymob — server-only secrets/configuration.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Optional WhatsApp Cloud API settings (server-side only).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
