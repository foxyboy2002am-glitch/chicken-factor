{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chicken-factor-online-ordering",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "chicken-factor-online-ordering"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://jjwvrqfeixxntdljqxsp.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_65lUdJ3fKq1X0KzewNY8gw_q7ZJmCwD"
  }
}
